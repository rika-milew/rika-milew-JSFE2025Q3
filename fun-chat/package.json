{
  "name": "fun-chat",
  "version": "1.0.0",
  "description": "settings for students' repos",
  "homepage": "https://rolling-scopes-school.github.io/rika-milew-JSFE2025Q3/fun-chat",
  "bugs": {
    "url": "https://github.com/ansivgit/mentoring-settings/issues"
  },
  "license": "ISC",
  "author": "Erika Milevskaya",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npx vite build && npx gh-pages -d dist -e fun-chat",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "ci:format": "prettier --check \"src/**/*.{ts,css}\"",
    "lint": "eslint src/**/*.ts",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "prepare": "cd .. && husky install fun-chat/.husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rolling-scopes-school/rika-milew-JSFE2025Q3.git"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "eslint",
      "prettier --check"
    ],
    "src/**/*.{css,scss}": [
      "stylelint",
      "prettier --check"
    ]
  },
  "validate-branch-name": {
    "pattern": "^(feat|fix|chore|docs|test|refactor)/.+$"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "gh-pages": "^6.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "stylelint": "^16.26.1",
    "stylelint-config-clean-order": "^8.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "validate-branch-name": "^1.3.2",
    "vite": "^7.2.4"
  }
}
