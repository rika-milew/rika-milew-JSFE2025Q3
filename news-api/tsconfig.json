{
  "compilerOptions": {
 
    "rootDir": "./src",
    "outDir": "./dist",

   
    "module": "ESNext",
    "target": "ES6",
    "types": [],
   
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

  
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "noImplicitAny": true,  
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
